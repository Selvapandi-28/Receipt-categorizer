# GEMINI_API_KEY: Required for Gemini AI receipt analysis.
# Create an API key in Google AI Studio and paste it here or set it in your Vercel Dashboard.
GEMINI_API_KEY=

# SMTP Email Configuration (Optional - for real Gmail / SMTP email OTP delivery)
# For Gmail, set SMTP_USER to your Gmail address and SMTP_PASS to a Gmail App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
